# ============================================================
#  Educa360 Backend - Variables de PRODUCCIÓN (plantilla)
# ------------------------------------------------------------
#  Este archivo NO lo lee Railway: es SOLO documentación.
#  En Railway, pega estas variables en el panel del servicio
#  (servicio -> Variables -> Raw Editor).
#
#  NUNCA pongas valores reales aquí: este archivo se versiona.
#  Los secretos viven en Railway y en tu gestor de contraseñas.
#
#  La guía completa está en docs/DEPLOY.md.
# ============================================================

# ---------- Base de datos (PostgreSQL de Supabase) ----------
# Usa el Session Pooler (puerto 5432), no el Transaction Pooler (6543):
# Flyway necesita una conexión estable para aplicar migraciones.
# En una variable de entorno la contraseña va SIN URL-encoding
# (si el panel de Supabase muestra %2B o %3D, decodifícalos).
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>

# ---------- Flyway ----------
# Producción: SOLO migraciones, sin datos demo.
FLYWAY_LOCATIONS=classpath:db/migration

# ---------- JWT ----------
# Mínimo 32 bytes. Genera uno con: openssl rand -base64 48
APP_JWT_SECRET=<jwt-secret-min-32-bytes>
APP_JWT_EXPIRATION_MS=86400000

# ---------- CORS ----------
# Mientras el frontend no tenga dominio: *
# Cuando exista: https://tu-frontend.vercel.app
APP_CORS_ALLOWED_ORIGINS=*

# ---------- Supabase Storage (M8) ----------
# Buckets privados: materiales y sustentos.
APP_SUPABASE_URL=https://<project-ref>.supabase.co
APP_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------- Logs ----------
SPRING_JPA_SHOW_SQL=false

# ---------- Puerto ----------
# NO definas PORT: Railway lo inyecta automáticamente y la app lo usa
# (server.port=${PORT:8080}).
